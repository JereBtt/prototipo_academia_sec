---
import "../styles/global.css";

const {
  title = "Salsa en Córdoba | Clases de Salsa y Bachata en Córdoba",
  description = "Salsa en Córdoba es una academia de baile en Córdoba Capital con clases de salsa y bachata desde cero y para personas con experiencia en Av. Vélez Sarsfield 520.",
  canonical = "https://www.salsaencordoba.com.ar/",
  image = "https://www.salsaencordoba.com.ar/images/hero-carousel-1-salsa-bachata.png",
} = Astro.props;

const seoKeywords = [
  "Salsa en Córdoba",
  "salsa cordoba",
  "salsa córdoba",
  "clases de salsa en Córdoba",
  "clases de salsa en Córdoba Capital",
  "clases de bachata en Córdoba",
  "clases de bachata en Córdoba Capital",
  "aprender a bailar salsa",
  "aprender bachata",
  "academia de salsa y bachata en Córdoba",
  "dónde hacer salsa en Córdoba",
  "donde hacer salsa en cordoba",
  "tomar clases de salsa",
  "salsa y bachata en Córdoba",
  "clases de baile en Córdoba",
  "Av. Vélez Sarsfield 520",
].join(", ");

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "SportsActivityLocation"],
  "@id": `${canonical}#academia`,
  name: "Salsa en Córdoba",
  alternateName: "Academia Salsa en Córdoba",
  description,
  url: canonical,
  image,
  logo: "https://www.salsaencordoba.com.ar/images/logo-navbar-test.png",
  telephone: "+54 9 351 371-5379",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. Vélez Sarsfield 520",
    addressLocality: "Córdoba",
    addressRegion: "Córdoba",
    addressCountry: "AR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -31.4201,
    longitude: -64.1888,
  },
  areaServed: {
    "@type": "City",
    name: "Córdoba",
  },
  sameAs: [
    "https://www.instagram.com/salsa.en.cordoba",
    "https://www.facebook.com/Salsa.en.Cordoba1",
  ],
  makesOffer: [
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Clases de salsa y bachata desde cero",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Clases de salsa y bachata para personas con experiencia",
      },
    },
  ],
};
---

<!doctype html>
