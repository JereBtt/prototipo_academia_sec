    <meta name="Keywords" content={seoKeywords} />
    <meta name="classification" content="clases de salsa en Córdoba, clases de bachata en Córdoba, academia de baile en Córdoba Capital, aprender a bailar salsa y bachata" />
    <meta name="Classification" content="clases de salsa en Córdoba, clases de bachata en Córdoba, academia de baile en Córdoba Capital, aprender a bailar salsa y bachata" />
    <meta name="robots" content="index, follow" />
