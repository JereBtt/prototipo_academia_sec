  "mt-4 font-[Arial] text-xl sm:text-2xl leading-relaxed";
---

<BaseLayout>
  <div class="min-h-screen overflow-x-hidden bg-foreground text-card">
    <button
      type="button"
      data-mobile-backdrop
      aria-label="Cerrar menú"
      class="fixed inset-0 z-40 hidden cursor-default bg-transparent lg:hidden"
    ></button>

    <!-- Header -->
    <header
      class="fixed left-0 right-0 top-0 z-50 border-b border-red-950/50 bg-[#5f100f]/95 font-[Arial] shadow-lg shadow-black/20 backdrop-blur-sm"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
          class="grid h-16 grid-cols-[1fr_2.5rem] items-center gap-3 lg:h-20 lg:grid-cols-[11rem_1fr_11rem] lg:gap-4"
        >
          <a
            href="#inicio"
            class="relative z-20 h-16 w-32 self-stretch overflow-visible lg:h-20 lg:w-44"
            aria-label="Ir al inicio"
          >
            <div
              class="absolute left-0 top-0 h-24 w-32 overflow-visible drop-shadow-[0_8px_10px_rgba(0,0,0,0.45)] lg:h-32 lg:w-44"
            >
              <img
                src="/images/logo-navbar-test.png"
                alt="Salsa en Córdoba"
                class="h-full w-full object-contain"
                fetchpriority="high"
              />
            </div>
            <span class="sr-only">Salsa en Córdoba</span>
          </a>

          <nav
            class="hidden h-full items-center justify-center gap-6 self-center lg:flex xl:gap-8"
          >
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class="text-center text-base font-semibold uppercase tracking-wide text-card/80 transition-colors hover:text-primary"
                >
                  {item.name}
                </a>
              ))
            }
          </nav>

          <div class="flex items-center justify-self-end self-center gap-3">
            <div class="hidden items-center gap-2 lg:flex">
              {
                navbarSocialLinks.map((link) => (
                  <a
                    aria-label={link.label}
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`flex h-11 w-11 items-center justify-center rounded-full opacity-70 saturate-[.45] ring-1 ring-white/25 transition duration-200 hover:-translate-y-0.5 hover:opacity-100 hover:saturate-100 ${link.className}`}
                    set:html={link.icon}
                  />
                ))
              }
            </div>
            <button
              data-menu-toggle
              class="self-center justify-self-end p-2 text-card lg:hidden"
              aria-expanded="false"
              aria-controls="mobile-menu"
              aria-label="Abrir menú"
            >
              <span data-menu-open class="block text-3xl leading-none">☰</span>
              <span data-menu-close class="hidden text-3xl leading-none">×</span
              >
            </button>
          </div>
        </div>
      </div>

      <div
        id="mobile-menu"
        data-mobile-menu
        class="hidden border-t border-red-950/50 bg-[#5f100f] shadow-xl lg:hidden"
      >
        <div class="space-y-3 px-4 py-4">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="block py-2 text-base font-semibold uppercase tracking-wide text-card/90 transition-colors hover:text-primary"
                data-mobile-link
              >
                {item.name}
              </a>
            ))
          }
          <div class="mt-4 flex items-center justify-center gap-3">
            {
              navbarSocialLinks.map((link) => (
                <a
                  aria-label={link.label}
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`flex h-12 w-12 items-center justify-center rounded-full ring-1 ring-white/20 transition duration-200 active:scale-95 ${link.className}`}
                  set:html={link.icon}
                />
              ))
            }
          </div>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section
      id="inicio"
      data-hero
      class="relative flex min-h-screen items-center overflow-hidden pt-24 font-[Arial] lg:pt-32"
    >
      <div class="absolute inset-0">
        <div
          data-hero-bg
          class="absolute -inset-y-28 inset-x-0 will-change-transform"
          style="transform: translate3d(0, var(--hero-parallax, 0px), 0) scale(1.1)"
        >
          <img
            src="/images/background-hero.png"
            alt=""
            class="h-full w-full object-cover object-center"
            fetchpriority="high"
          />
        </div>
        <div class="absolute inset-0 bg-foreground/58"></div>
        <div
          class="absolute inset-0 bg-gradient-to-b from-foreground/35 via-transparent to-foreground/50"
        >
        </div>
      </div>

      <div
        class="absolute right-10 top-1/4 hidden h-32 w-32 animate-pulse rounded-full border-4 border-primary/30 lg:block"
      >
      </div>
      <div
        class="absolute bottom-1/4 left-10 hidden h-20 w-20 rounded-full bg-primary/20 blur-xl lg:block"
      >
      </div>

      <div
        class="relative z-10 mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-12"
      >
        <div class="mx-auto flex max-w-7xl flex-col items-center text-center">
          <div class="mb-5 w-full max-w-5xl sm:mb-7">
            <div class="relative mx-auto text-center">
              <div class="mb-3 flex items-center justify-center gap-3 sm:gap-4">
                <span
                  class="h-px w-10 bg-gradient-to-r from-transparent via-amber-300 to-amber-300 sm:w-20"
                ></span>
                <span
                  class="text-xs font-extrabold uppercase tracking-[0.34em] text-amber-200 drop-shadow-[0_2px_10px_rgba(0,0,0,0.7)] sm:text-sm lg:text-base"
                >
                  Academia de baile en Córdoba
                </span>
                <span
                  class="h-px w-10 bg-gradient-to-l from-transparent via-amber-300 to-amber-300 sm:w-20"
                ></span>
              </div>

              <div
                class="relative flex items-center justify-center gap-2 sm:gap-5"
              >
                <span
                  class="hidden text-4xl text-amber-300 drop-shadow-[0_0_16px_rgba(251,191,36,0.75)] sm:inline"
                  >✦</span
                >
                <h1
                  class="text-balance font-[Arial] text-3xl font-black leading-tight text-card drop-shadow-[0_4px_18px_rgba(0,0,0,0.72)] sm:text-5xl lg:text-6xl"
                >
                  Aprendé <span
                    class="bg-gradient-to-r from-amber-200 via-yellow-400 to-amber-500 bg-clip-text text-transparent drop-shadow-[0_0_18px_rgba(251,191,36,0.28)]"
                    >Salsa y Bachata</span
                  >
                  <span class="sr-only"> en Córdoba</span>
                </h1>
                <span
                  class="hidden text-4xl text-amber-300 drop-shadow-[0_0_16px_rgba(251,191,36,0.75)] sm:inline"
                  >✦</span
                >
              </div>

              <div class="mt-3 flex items-center justify-center gap-3 sm:mt-4">
                <span
                  class="h-px w-12 bg-gradient-to-r from-transparent to-amber-300/70 sm:w-24"
                ></span>
                <span
                  class="rounded-full border border-amber-300/85 bg-foreground/35 px-5 py-1.5 text-sm font-extrabold lowercase tracking-[0.08em] text-card shadow-[0_0_18px_rgba(251,191,36,0.18)] backdrop-blur-sm sm:px-6 sm:text-lg"
                >
                  desde cero
                </span>
                <span
                  class="h-px w-12 bg-gradient-to-l from-transparent to-amber-300/70 sm:w-24"
                ></span>
              </div>
            </div>
          </div>

          <div class="w-full max-w-4xl">
            <div
