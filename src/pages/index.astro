];

const testimonials = [
  {
    name: "Sandra Vilca",
    role: "Empezó desde cero",
    quote:
      "Siempre me gustó la Salsa y la Bachata, fui sola porque no tenía con quién empezar y pensé que iba a sentirme incómoda. Fue todo lo contrario. Las parejas se van armando y rotando durante la clase, así que enseguida te integrás. El ambiente es muy cálido y los profes están siempre atentos para ayudarte. Fue una de las mejores decisiones que tomé.",
