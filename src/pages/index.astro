<script define:vars={{ testimonials }}>
  const testimonialCards = [
    ...document.querySelectorAll("[data-testimonial-card]"),
  ];
  const testimonialPrev = document.querySelector("[data-testimonial-prev]");
  const testimonialNext = document.querySelector("[data-testimonial-next]");
  let testimonialStart = 0;
  let testimonialTimer;

  const getVisibleTestimonials = () =>
    testimonialCards.map(
      (_, index) =>
        testimonials[(testimonialStart + index) % testimonials.length],
    );

  const preloadTestimonialImages = () => {
    testimonials.forEach((testimonial) => {
      const image = new Image();
      image.src = testimonial.image;
    });
  };

  const renderTestimonials = () => {
    getVisibleTestimonials().forEach((testimonial, index) => {
      const card = testimonialCards[index];
      const image = card.querySelector("[data-testimonial-image]");
      const name = card.querySelector("[data-testimonial-name]");
      const role = card.querySelector("[data-testimonial-role]");
      const quote = card.querySelector("[data-testimonial-quote]");

      image.src = testimonial.image;
      image.alt = testimonial.name;
      name.textContent = testimonial.name;
      role.textContent = testimonial.role;
      quote.textContent = `“${testimonial.quote}”`;
    });
  };

  const rotateTestimonials = (direction = -1) => {
    testimonialCards.forEach((card, index) => {
      card.classList.add("opacity-0");
      card.classList.toggle("-translate-x-4", direction < 0 && index === 0);
      card.classList.toggle("translate-x-4", direction < 0 && index === 2);
      card.classList.toggle("translate-x-4", direction > 0 && index === 0);
      card.classList.toggle("-translate-x-4", direction > 0 && index === 2);
    });

    window.setTimeout(() => {
      testimonialStart =
        (testimonialStart + direction + testimonials.length) %
        testimonials.length;
      renderTestimonials();

      testimonialCards.forEach((card) => {
        card.classList.remove("opacity-0", "-translate-x-4", "translate-x-4");
      });
    }, 260);
  };

  const restartTestimonials = () => {
    window.clearInterval(testimonialTimer);
    testimonialTimer = window.setInterval(() => rotateTestimonials(-1), 5200);
  };

  if (
    testimonialCards.length &&
    testimonials.length > testimonialCards.length
  ) {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(preloadTestimonialImages);
    } else {
      window.setTimeout(preloadTestimonialImages, 1200);
    }

    testimonialPrev?.addEventListener("click", () => {
      rotateTestimonials(1);
      restartTestimonials();
    });
    testimonialNext?.addEventListener("click", () => {
      rotateTestimonials(-1);
      restartTestimonials();
    });
    restartTestimonials();
  }
</script>

<script>
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");
  const mobileBackdrop = document.querySelector("[data-mobile-backdrop]");
  const menuOpenIcon = document.querySelector("[data-menu-open]");
  const menuCloseIcon = document.querySelector("[data-menu-close]");
  const mobileLinks = document.querySelectorAll("[data-mobile-link]");

  const setMenuOpen = (open) => {
    mobileMenu?.classList.toggle("hidden", !open);
    mobileBackdrop?.classList.toggle("hidden", !open);
    menuOpenIcon?.classList.toggle("hidden", open);
    menuCloseIcon?.classList.toggle("hidden", !open);
    menuToggle?.setAttribute("aria-expanded", String(open));
    menuToggle?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };

  menuToggle?.addEventListener("click", () =>
    setMenuOpen(mobileMenu?.classList.contains("hidden") ?? true),
  );
  mobileBackdrop?.addEventListener("click", () => setMenuOpen(false));
  mobileLinks.forEach((link) =>
    link.addEventListener("click", () => setMenuOpen(false)),
  );

  const hero = document.querySelector("[data-hero]");
  const reduceMotionQuery = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );
  let parallaxFrame = null;

  const updateParallax = () => {
    parallaxFrame = null;
    if (!hero || reduceMotionQuery.matches) {
      hero?.style.setProperty("--hero-parallax", "0px");
      return;
    }
    const rect = hero.getBoundingClientRect();
    if (rect.bottom <= 0 || rect.top >= window.innerHeight) return;
    const mobile = window.matchMedia("(max-width: 767px)").matches;
    const scrollDistance = window.scrollY - hero.offsetTop;
    const strength = mobile ? 0.46 : 0.38;
    const minOffset = mobile ? -72 : -56;
    const maxOffset = mobile ? 150 : 190;
    const offset = Math.min(
      Math.max(scrollDistance * strength, minOffset),
      maxOffset,
    );
    hero.style.setProperty("--hero-parallax", `${offset}px`);
  };

  const requestParallax = () => {
    if (parallaxFrame === null) {
      parallaxFrame = window.requestAnimationFrame(updateParallax);
    }
  };

  updateParallax();
  window.addEventListener("scroll", requestParallax, { passive: true });
  window.addEventListener("resize", requestParallax);
  reduceMotionQuery.addEventListener("change", requestParallax);

  const slides = [...document.querySelectorAll("[data-hero-slide]")];
  const dots = [...document.querySelectorAll("[data-slide-dot]")];
  const prev = document.querySelector("[data-slide-prev]");
  const next = document.querySelector("[data-slide-next]");
  let activeSlide = 0;
  let slideTimer;

  const setSlide = (nextIndex) => {
    activeSlide = (nextIndex + slides.length) % slides.length;
    slides.forEach((slide, index) => {
      slide.classList.toggle("opacity-100", index === activeSlide);
      slide.classList.toggle("scale-100", index === activeSlide);
      slide.classList.toggle("opacity-0", index !== activeSlide);
      slide.classList.toggle("scale-[1.02]", index !== activeSlide);
      slide.setAttribute(
        "aria-hidden",
        index === activeSlide ? "false" : "true",
      );
    });
    dots.forEach((dot, index) => {
      dot.classList.toggle("w-9", index === activeSlide);
      dot.classList.toggle("bg-primary", index === activeSlide);
      dot.classList.toggle("w-3", index !== activeSlide);
      dot.classList.toggle("bg-card/45", index !== activeSlide);
    });
  };

  const restartTimer = () => {
    window.clearInterval(slideTimer);
    slideTimer = window.setInterval(() => setSlide(activeSlide + 1), 4200);
  };

  prev?.addEventListener("click", () => {
    setSlide(activeSlide - 1);
    restartTimer();
  });
  next?.addEventListener("click", () => {
    setSlide(activeSlide + 1);
    restartTimer();
  });
  dots.forEach((dot, index) =>
    dot.addEventListener("click", () => {
      setSlide(index);
      restartTimer();
    }),
  );
  restartTimer();

  const contactCard = document.querySelector("[data-contact-card]");
  const openWhatsappWidget = () =>
    window.dispatchEvent(new Event("open-whatsapp-widget"));
  contactCard?.addEventListener("click", openWhatsappWidget);
  contactCard?.addEventListener("focusin", openWhatsappWidget);
  contactCard?.addEventListener("keydown", (event) => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      openWhatsappWidget();
    }
  });

  const copyAddressButtons = document.querySelectorAll("[data-copy-address]");

  const copyText = async (text) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
  };

  copyAddressButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const address = button.getAttribute("data-copy-address");
      if (!address) return;

      await copyText(address);
      const feedback = button.querySelector("[data-copy-feedback]");
      feedback?.classList.remove("hidden");
      window.setTimeout(() => feedback?.classList.add("hidden"), 1600);
    });
  });
</script>
